# AI-Powered Intern Review & Task Automation System
# Copy this file to `server/.env` and fill in optional credentials.
# All features operate seamlessly out of the box in SAFE DEMO MODE if credentials are omitted.

# Server Port
PORT=5000

# Coordinator / Administrator Email
ADMIN_EMAIL=coordinator@company.com

# AI Provider Configuration (Optional)
# If left empty, the application uses the built-in Deterministic Demo Evaluator with senior mentor feedback.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail SMTP Configuration for Live Email Delivery (Optional)
# If left empty, the application runs in SAFE TEST MODE: all emails are recorded in SQLite audit logs.
# To enable real delivery:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your full Gmail address and App Password below (without spaces):
EMAIL_USER=
EMAIL_APP_PASSWORD=
